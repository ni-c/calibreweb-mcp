{
  "compilerOptions": {
    "target": "ES2023",
    // ES2024 for `String#toWellFormed`, which every supported Node has (20+).
    // Setting `lib` at all drops the default DOM types; nothing here needs
    // them — `fetch`, `Response` and `Headers` come from @types/node.
    "lib": ["ES2024"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
